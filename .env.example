# Generate APP_SECRET and a strong administrator password before first start.
# This file contains examples only. Keep the actual .env outside Git.
NODE_ENV=production
APP_URL=https://renewly.example.com
APP_SECRET=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Defaults below are suitable for an HTTPS reverse proxy on the same server.
ALLOW_REGISTRATION=true
COOKIE_SECURE=true
TRUST_PROXY=false
REMINDER_INTERVAL_MS=60000
PORT=3000
DATA_DIR=./data

# The latest tag follows successful builds from the default branch.
RENEWLY_IMAGE=ghcr.io/zikq-shmily/renewly:latest
BIND_ADDRESS=127.0.0.1
HOST_PORT=3000
RENEWLY_DATA_VOLUME=renewly-data
