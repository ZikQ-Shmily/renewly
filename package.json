{
  "name": "renewly",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "续记 Renewly — 多用户订阅、续费预算与到期提醒管理",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --env-file-if-exists=.env --import tsx --watch server/index.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "typecheck": "tsc -p tsconfig.server.json && tsc -p client/tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "build:client": "vite build --config client/vite.config.ts",
    "build:server": "esbuild server/index.ts server/cli.ts --bundle --platform=node --target=node24 --format=esm --packages=external --outdir=dist/server",
    "build": "npm run build:client && npm run build:server",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "db:backup": "node --env-file-if-exists=.env dist/server/cli.js backup",
    "db:migrate": "node --env-file-if-exists=.env dist/server/cli.js migrate"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "better-sqlite3": "13.0.3",
    "hono": "4.13.17",
    "lucide-react": "1.71.0",
    "nodemailer": "10.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.7"
  }
}
